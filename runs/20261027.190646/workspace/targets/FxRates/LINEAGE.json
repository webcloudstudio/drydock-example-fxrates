                "load-atomic"
              ]
            },
            {
              "name": "usage-errors",
              "text": "check U1 2 < /dev/null\ncheck U2 2 frobnicate < /dev/null\ncheck U3 2 load < /dev/null\ncheck U4 2 serve --port notaport < /dev/null",
              "stories": [
                "cli-usage",
                "foundation-cli",
                "serve"
              ]
            },
            {
              "name": "serve-http",
              "text": "start_server",
              "stories": [
                "serve",
                "foundation-web"
              ]
            },
            {
              "name": "health-endpoint",
              "text": "http H1 200 '/health' <<'EOF'\n{\"status\":\"ok\"}\nEOF",
              "stories": [
                "health"
              ]
            },
            {
              "name": "stats-endpoint",
              "text": "http H2 200 '/stats' <<'EOF'\n{\"dates\":22,\"rates\":176,\"first\":\"2025-01-02\",\"last\":\"2025-01-31\"}\nEOF",
              "stories": [
                "stats"
              ]
            },
            {
              "name": "currencies-endpoint",
              "text": "http H3 200 '/currencies' <<'EOF'\n{\"base\":\"EUR\",\"currencies\":[\"AUD\",\"CAD\",\"CHF\",\"CNY\",\"GBP\",\"JPY\",\"SEK\",\"USD\"]}\nEOF",
              "stories": [
                "currencies"
              ]
            },
            {
              "name": "rates-by-date",
              "text": "http H4 200 '/rates/2025-01-17' <<'EOF'\n{\"date\":\"2025-01-17\",\"requested\":\"2025-01-17\",\"base\":\"EUR\",\"rates\":{\"AUD\":\"1.6646\",\"CAD\":\"1.4864\",\"CHF\":\"0.9394\",\"CNY\":\"7.5474\",\"GBP\":\"0.84453\",\"JPY\":\"160.23\",\"SEK\":\"11.506\",\"USD\":\"1.0298\"}}\nEOF",
              "stories": [
