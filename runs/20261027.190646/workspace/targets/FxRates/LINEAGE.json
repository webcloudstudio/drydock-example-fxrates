              "text": "http H19 404 '/history/HRK' < /dev/null",
              "stories": [
                "history-rejects"
              ]
            },
            {
              "name": "history-empty-range",
              "text": "http H20 200 '/history/USD?start=2025-02-01' <<'EOF'\n{\"currency\":\"USD\",\"base\":\"EUR\",\"count\":0,\"min\":null,\"max\":null,\"mean\":null,\"points\":[]}\nEOF",
              "stories": [
                "history-empty",
                "history"
              ]
            },
            {
              "name": "history-malformed-date",
              "text": "http H21 422 '/history/GBP?start=2025-01-31-x' < /dev/null",
              "stories": [
                "history-rejects"
              ]
            },
