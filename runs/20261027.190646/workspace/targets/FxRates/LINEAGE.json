              ]
            },
            {
              "name": "load-idempotent",
              "text": "check A3 0 load \"$DATA/eurofxref-hist_2025-01.csv\" <<'EOF'\ndates,rates\n22,176\nEOF",
              "stories": [
                "rate-store",
                "load-atomic",
                "load-summary"
              ]
            },
            {
              "name": "load-rejects-bad-file",
