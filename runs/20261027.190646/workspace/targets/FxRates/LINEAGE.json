  "sources": {
    "INSTRUCTIONS.md": {
      "state": "current",
      "versions": [
        {
          "commit": "0f1ecf2",
          "date": "2026-10-27",
          "hash": "e2f769c79ef323f414be84404dcc583a63db489da16e56e1a87075207a5c5ed8",
          "release": "",
          "state": "consumed",
          "via": "plan",
          "ticket": null,
          "requirements": [
            {
              "name": "python-stack",
              "text": "Implement in Python 3.11 or newer with FastAPI, served by uvicorn, over SQLite. Tests run under\npytest, using FastAPI's `TestClient` for the API. The product is an executable named `fxrates` at\nthe application root.",
              "stories": [
                "foundation-python",
                "foundation-web"
              ]
            },
            {
              "name": "run-harness-scoring",
              "text": "`sources/run.sh` is the scoring entry point. It is supplied, not authored, and is staged verbatim\ninto the application root with the data files. `drydock uat` runs `sh sources/run.sh` from the\ncompleted application root and takes its exit code and output as the score.",
              "stories": [
                "verification"
              ]
            },
            {
              "name": "database-location",
              "text": "`DATABASE_URL` names the SQLite database file, optionally prefixed `sqlite://`. When it is unset,\n`DATABASE_PATH` is used, then `data/app.db`. All database access goes through the shipped\npersistence library and the relational layer generated from `DATABASE.md`. Application code never\nopens a database driver directly.",
              "stories": [
                "foundation-python",
                "database"
              ]
            },
            {
              "name": "rates-table",
              "text": "| `rates` | `date` text `YYYY-MM-DD`, `currency` text, `rate` text | unique (`date`, `currency`) |",
              "stories": [
                "database",
                "rate-store"
              ]
            },
            {
              "name": "rate-text-storage",
              "text": "A rate is stored exactly as the ECB publishes it, as text. `0.943` stays `0.943`, never `0.9430`\nand never a float. Arithmetic on rates uses Python's `decimal` module.",
              "stories": [
                "rate-store",
                "load-parse"
              ]
            },
            {
              "name": "init-command",
              "text": "The initializer creates missing\ntables and indexes from the generated script; it never drops tables, deletes records, or migrates\nexisting table definitions. Repeated init succeeds and preserves all existing rates.",
              "stories": [
                "cli-init",
                "database",
                "foundation-cli"
              ]
            },
            {
              "name": "load-command",
              "text": "| `fxrates load <csv>` | Loads an ECB history file (rules below). | `dates,rates`, then the number of dates and of rates stored from the file. |",
              "stories": [
                "load-atomic",
                "load-parse",
                "rate-store",
                "foundation-cli"
              ]
            },
            {
              "name": "load-summary-output",
              "text": "The reported `dates` counts the dates with at least one stored rate, and `rates` counts the\nrates stored.",
              "stories": [
                "load-summary"
              ]
            },
            {
              "name": "ecb-file-format",
              "text": "The file is CSV. The header's first field is `Date`, and every other field is a three-letter\nuppercase currency code. The ECB writes a trailing comma on every line, and the resulting\nempty last field is ignored.",
              "stories": [
                "load-parse"
              ]
            },
            {
              "name": "ecb-row-values",
              "text": "Each row is a date (`YYYY-MM-DD`, a real calendar date, not repeated within the file) followed\nby one value per currency. The value `N/A` means no rate, and nothing is stored for it. Any\nother value must match `[0-9]+(\\.[0-9]+)?` and be nonzero.",
              "stories": [
                "load-parse"
              ]
            },
            {
              "name": "rejected-file-atomic",
              "text": "**A rejected file changes nothing.** The whole file is checked before the first write. A row\nwith the wrong field count, an invalid or repeated date, or an invalid value rejects the file.",
              "stories": [
                "load-atomic",
                "load-parse"
              ]
            },
            {
              "name": "load-replace-idempotent",
              "text": "A rate for a (`date`, `currency`) that is already stored replaces it, so loading the same file\ntwice leaves the database unchanged.",
              "stories": [
                "rate-store",
                "load-atomic"
              ]
            },
            {
              "name": "fetch-command",
              "text": "| `fxrates fetch` | Downloads `https://www.ecb.europa.eu/stats/eurofxref/eurofxref-hist.zip`, extracts `eurofxref-hist.csv`, and loads it as `load` does. | As `load`. |",
              "stories": [
                "fetch",
                "cli-failures"
              ]
            },
            {
              "name": "serve-command",
              "text": "| `fxrates serve [--port <n>]` | Serves the HTTP API on `127.0.0.1:<n>` with uvicorn until stopped. Default port `8000`. | Nothing required. |",
              "stories": [
                "serve",
                "foundation-cli"
              ]
            },
            {
              "name": "failing-command-output",
              "text": "A failing command writes nothing to standard output and one diagnostic line to standard error.\n`fetch` is never run by the harness. Its tests replace the download with a stub and never use the\nnetwork.",
              "stories": [
                "cli-failures",
                "foundation-cli"
              ]
            },
            {
              "name": "exit-codes",
              "text": "**Exit codes.** `0` success. `1` operational failure: the file cannot be read, or a `fetch`\ndownload fails. `2` usage error: unknown command, wrong argument count, `--port` not an integer.\n`3` rejected file.",
              "stories": [
                "foundation-cli",
                "cli-usage",
                "cli-failures",
                "load-atomic"
              ]
            },
            {
              "name": "effective-date-rule",
              "text": "**Effective date.** The ECB publishes on working days only. A request for date `D` uses the latest\npublication date on or before `D`. If none exists, the response is `404`.",
              "stories": [
                "effective-date",
                "rates-by-date",
                "convert",
                "history"
              ]
            },
            {
              "name": "health-endpoint",
              "text": "| `GET /health` | `{\"status\": \"ok\"}` |",
              "stories": [
                "health"
              ]
            },
            {
              "name": "stats-endpoint",
              "text": "| `GET /stats` | `{\"dates\": <n>, \"rates\": <n>, \"first\": <date>, \"last\": <date>}`. `first` and `last` are `null` when the table is empty. |",
              "stories": [
                "stats"
              ]
            },
            {
              "name": "currencies-endpoint",
              "text": "| `GET /currencies` | `{\"base\": \"EUR\", \"currencies\": [<code>, ...]}`: every currency with at least one stored rate, ascending. |",
              "stories": [
                "currencies"
              ]
            },
            {
              "name": "rates-by-date-endpoint",
              "text": "| `GET /rates/{date}` | `{\"date\": <effective date>, \"requested\": <date>, \"base\": \"EUR\", \"rates\": {<code>: <rate>, ...}}`: every currency with a rate on the effective date. |",
              "stories": [
                "rates-by-date",
                "effective-date"
              ]
            },
            {
              "name": "rates-latest-endpoint",
              "text": "| `GET /rates/latest` | As `/rates/{date}` for the latest publication date, with `\"requested\": \"latest\"`. |",
              "stories": [
                "rates-latest",
                "effective-date"
              ]
            },
            {
              "name": "convert-endpoint",
              "text": "| `GET /convert?from=<code>&to=<code>&amount=<amount>[&date=<date>]` | `{\"date\": <effective date>, \"from\": <code>, \"to\": <code>, \"amount\": <amount>, \"rate\": <rate>, \"result\": <result>}`. Without `date`, the latest publication date is used. |",
              "stories": [
                "convert",
                "convert-latest",
                "effective-date"
              ]
            },
            {
              "name": "history-endpoint",
              "text": "| `GET /history/{code}[?start=<date>][&end=<date>]` | `{\"currency\": <code>, \"base\": \"EUR\", \"count\": <n>, \"min\": <rate>, \"max\": <rate>, \"mean\": <mean>, \"points\": [{\"date\": <date>, \"rate\": <rate>}, ...]}` for the publication dates from `start` through `end` inclusive, ascending. Both bounds are optional. With no points, `count` is `0`, `min`, `max`, and `mean` are `null`, and `points` is `[]`. |",
              "stories": [
                "history",
                "history-empty",
                "history-rejects"
              ]
            },
            {
              "name": "rate-value-formats",
              "text": "- `<rate>` in `/rates`, `min`, `max`, and `points` is the stored text, as a JSON string.\n- `/convert` `amount` matches `[0-9]+(\\.[0-9]+)?` and is echoed as given, as a JSON string.",
              "stories": [
                "rates-by-date",
                "rates-latest",
                "history",
                "convert"
              ]
            },
            {
              "name": "convert-rate-rounding",
              "text": "- `/convert` `rate` is `rate(to) / rate(from)`, computed exactly and rounded half to even to six\n  decimal places, written with exactly six decimals, as a JSON string: `\"161.770000\"`.",
              "stories": [
                "convert",
                "convert-latest"
              ]
            },
            {
              "name": "convert-result-rounding",
              "text": "- `/convert` `result` is `amount \u00d7 rate(to) / rate(from)`, computed exactly from the stored rates\n  (not from the rounded `rate`) and rounded half to even to two decimal places, written with\n  exactly two decimals, as a JSON string: `\"82.01\"`.",
              "stories": [
                "convert",
                "convert-latest"
              ]
            },
            {
              "name": "history-statistics-format",
              "text": "- `/history` `min` and `max` are the stored text of the smallest and largest rate by value.\n  `mean` is the exact mean rounded half to even to six decimal places, written with exactly six\n  decimals, as a JSON string.",
              "stories": [
                "history",
                "history-empty"
              ]
            },
            {
              "name": "not-found-errors",
              "text": "| `404` | No publication on or before the requested date; a `/convert` currency other than EUR with no rate on the effective date; a `/history` currency with no stored rate at all (including `EUR`). |",
              "stories": [
                "effective-date",
                "convert-errors",
                "history-rejects",
                "rates-by-date"
              ]
            },
            {
              "name": "validation-errors",
              "text": "| `422` | A malformed date in the path or query, a malformed `amount`, or a missing required query parameter. FastAPI's request validation produces this status. |",
              "stories": [
                "convert-errors",
                "history-rejects",
                "rates-by-date"
              ]
            },
            {
              "name": "live-load-visibility",
              "text": "A load that completes while the server is running is visible to the next request.",
              "stories": [
                "live-visibility"
              ]
            },
            {
              "name": "test-suite",
              "text": "The completed application provides a POSIX-compatible `bin/test.sh` that runs its own pytest suite\nfrom the application root and exits zero only when every test passes. The suite covers each\ncommand, each load rule, each endpoint, the effective-date rule, rounding, and each error status,\nagainst real isolated test databases, with `fetch` stubbed.",
              "stories": [
                "foundation-python",
                "verification"
              ]
            }
          ]
        }
      ]
    },
