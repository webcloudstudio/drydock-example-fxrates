# Copy to .env to override defaults. Values shown are placeholders.
# Resolution order: DATABASE_URL, then DATABASE_PATH, then data/app.db.
# An unset or empty variable is skipped.

# SQLite file path, optionally prefixed with sqlite://
DATABASE_URL=sqlite://data/app.db

# SQLite file path, used when DATABASE_URL is unset or empty
DATABASE_PATH=data/app.db
