    "run.sh": {
      "state": "current",
      "versions": [
        {
          "commit": "57f541c",
          "date": "2026-10-24",
          "hash": "f0d6092c076f758abe72e7f0130422f3a1fbdcaa84e33eed747352af311efae7",
          "release": "",
          "state": "consumed",
          "via": "plan",
          "ticket": null,
          "requirements": [
            {
              "name": "deliverable-executable",
              "text": "The deliverable is an executable named fxrates at the application root.",
              "stories": [
                "conformance"
              ]
            },
            {
              "name": "initialize-store",
              "text": "check A1 0 init < /dev/null",
              "stories": [
                "initialize_store",
                "database"
              ]
            },
            {
              "name": "load-ecb-history",
              "text": "check A2 0 load \"$DATA/eurofxref-hist_2025-01.csv\" <<'EOF'\ndates,rates\n22,176\nEOF",
              "stories": [
                "load_history",
                "database"
              ]
            },
            {
              "name": "load-idempotently",
              "text": "check A3 0 load \"$DATA/eurofxref-hist_2025-01.csv\" <<'EOF'\ndates,rates\n22,176\nEOF",
              "stories": [
                "load_history",
                "database"
              ]
            },
            {
              "name": "reject-invalid-csv",
              "text": "check A4 3 load \"$DATA/eurofxref-hist_bad.csv\" < /dev/null",
              "stories": [
                "load_history",
                "cli_errors"
              ]
            },
            {
              "name": "report-missing-file",
              "text": "check A5 1 load \"$WORK/no-such-file.csv\" < /dev/null",
              "stories": [
                "load_history",
                "cli_errors"
              ]
            },
            {
              "name": "report-cli-usage-errors",
              "text": "check U1 2 < /dev/null",
              "stories": [
                "cli_errors"
              ]
            },
            {
              "name": "report-unknown-command",
              "text": "check U2 2 frobnicate < /dev/null",
              "stories": [
                "cli_errors"
              ]
            },
            {
              "name": "report-missing-load-argument",
              "text": "check U3 2 load < /dev/null",
              "stories": [
                "cli_errors"
              ]
            },
            {
              "name": "validate-serve-port",
              "text": "check U4 2 serve --port notaport < /dev/null",
              "stories": [
                "serve_api",
                "cli_errors"
              ]
            },
            {
              "name": "start-api-server",
              "text": "`fxrates serve` in the background and wait up to 30 s for /health.",
              "stories": [
                "serve_api"
              ]
            },
            {
              "name": "health-endpoint",
              "text": "http H1 200 '/health' <<'EOF'\n{\"status\":\"ok\"}\nEOF",
              "stories": [
                "api_health_stats"
              ]
            },
            {
              "name": "report-rate-statistics",
              "text": "http H2 200 '/stats' <<'EOF'\n{\"dates\":22,\"rates\":176,\"first\":\"2025-01-02\",\"last\":\"2025-01-31\"}\n</EOF>",
              "stories": [
                "api_health_stats",
                "database"
              ]
            },
            {
              "name": "list-currencies",
              "text": "http H3 200 '/currencies' <<'EOF'\n{\"base\":\"EUR\",\"currencies\":[\"AUD\",\"CAD\",\"CHF\",\"CNY\",\"GBP\",\"JPY\",\"SEK\",\"USD\"]}\nEOF",
              "stories": [
                "api_currencies"
              ]
            },
            {
              "name": "retrieve-effective-date-rates",
              "text": "http H4 200 '/rates/2025-01-17' <<'EOF'\n{\"date\":\"2025-01-17\",\"requested\":\"2025-01-17\",\"base\":\"EUR\",\"rates\":{\"AUD\":\"1.6646\",\"CAD\":\"1.4864\",\"CHF\":\"0.9394\",\"CNY\":\"7.5474\",\"GBP\":\"0.84453\",\"JPY\":\"160.23\",\"SEK\":\"11.506\",\"USD\":\"1.0298\"}}\nEOF",
              "stories": [
                "api_rates",
                "database"
              ]
            },
            {
              "name": "retrieve-effective-date-rates",
              "text": "http H5 200 '/rates/2025-01-18' <<'EOF'\n{\"date\":\"2025-01-17\",\"requested\":\"2025-01-18\",\"base\":\"EUR\",\"rates\":{\"AUD\":\"1.6646\",\"CAD\":\"1.4864\",\"CHF\":\"0.9394\",\"CNY\":\"7.5474\",\"GBP\":\"0.84453\",\"JPY\":\"160.23\",\"SEK\":\"11.506\",\"USD\":\"1.0298\"}}\nEOF",
              "stories": [
                "api_rates",
                "database"
              ]
            },
            {
              "name": "report-rate-date-errors",
              "text": "http H6 404 '/rates/2024-12-31' < /dev/null",
              "stories": [
                "api_rates",
                "cli_errors"
              ]
            },
            {
              "name": "report-rate-date-errors",
              "text": "http H7 422 '/rates/2025-13-01' < /dev/null",
              "stories": [
                "api_rates",
                "cli_errors"
              ]
            },
            {
              "name": "retrieve-latest-rates",
              "text": "http H8 200 '/rates/latest' <<'EOF'\n{\"date\":\"2025-01-31\",\"requested\":\"latest\",\"base\":\"EUR\",\"rates\":{\"AUD\":\"1.6702\",\"CAD\":\"1.5035\",\"CHF\":\"0.9449\",\"CNY\":\"7.5363\",\"GBP\":\"0.83608\",\"JPY\":\"160.99\",\"SEK\":\"11.474\",\"USD\":\"1.0393\"}}\nEOF",
              "stories": [
                "api_rates",
                "database"
              ]
            },
            {
              "name": "convert-currency-amount",
              "text": "http H9 200 '/convert?from=USD&to=GBP&amount=100&date=2025-01-17' <<'EOF'\n{\"date\":\"2025-01-17\",\"from\":\"USD\",\"to\":\"GBP\",\"amount\":\"100\",\"rate\":\"0.820091\",\"result\":\"82.01\"}\nEOF",
              "stories": [
                "api_convert",
                "database"
              ]
            },
            {
              "name": "convert-currency-amount",
              "text": "http H10 200 '/convert?from=EUR&to=JPY&amount=250.25&date=2025-01-05' <<'EOF'\n{\"date\":\"2025-01-03\",\"from\":\"EUR\",\"to\":\"JPY\",\"amount\":\"250.25\",\"rate\":\"161.770000\",\"result\":\"40482.94\"}\nEOF",
              "stories": [
                "api_convert",
                "database"
              ]
            },
            {
              "name": "convert-currency-amount",
              "text": "http H11 200 '/convert?from=GBP&to=EUR&amount=1000' <<'EOF'\n{\"date\":\"2025-01-31\",\"from\":\"GBP\",\"to\":\"EUR\",\"amount\":\"1000\",\"rate\":\"1.196058\",\"result\":\"1196.06\"}\nEOF",
              "stories": [
                "api_convert",
                "database"
              ]
            },
            {
              "name": "convert-currency-amount",
              "text": "http H12 200 '/convert?from=SEK&to=CNY&amount=12345.67&date=2025-01-20' <<'EOF'\n{\"date\":\"2025-01-20\",\"from\":\"SEK\",\"to\":\"CNY\",\"amount\":\"12345.67\",\"rate\":\"0.656236\",\"result\":\"8101.67\"}\nEOF",
              "stories": [
                "api_convert",
                "database"
              ]
            },
            {
              "name": "report-conversion-errors",
              "text": "http H13 404 '/convert?from=USD&to=XXX&amount=1' < /dev/null",
              "stories": [
                "api_convert",
                "cli_errors"
              ]
            },
            {
              "name": "report-conversion-errors",
              "text": "http H14 422 '/convert?from=USD&to=GBP' < /dev/null",
              "stories": [
                "api_convert",
                "cli_errors"
              ]
            },
            {
              "name": "report-conversion-errors",
              "text": "http H15 422 '/convert?from=USD&to=GBP&amount=abc' < /dev/null",
              "stories": [
                "api_convert",
                "cli_errors"
              ]
            },
            {
              "name": "report-conversion-errors",
              "text": "http H16 404 '/convert?from=USD&to=GBP&amount=10&date=2024-12-01' < /dev/null",
              "stories": [
                "api_convert",
                "cli_errors"
              ]
            },
            {
              "name": "retrieve-currency-history",
              "text": "http H17 200 '/history/USD?start=2025-01-20&end=2025-01-24' <<'EOF'\n{\"currency\":\"USD\",\"base\":\"EUR\",\"count\":5,\"min\":\"1.0316\",\"max\":\"1.0472\",\"mean\":\"1.039840\",\"points\":[{\"date\":\"2025-01-20\",\"rate\":\"1.0316\"},{\"date\":\"2025-01-21\",\"rate\":\"1.0357\"},{\"date\":\"2025-01-22\",\"rate\":\"1.0443\"},{\"date\":\"2025-01-23\",\"rate\":\"1.0404\"},{\"date\":\"2025-01-24\",\"rate\":\"1.0472\"}]}\nEOF",
              "stories": [
                "api_history",
                "database"
              ]
            },
            {
              "name": "retrieve-currency-history",
              "text": "http H18 200 '/history/CHF?start=2025-01-27' <<'EOF'\n{\"currency\":\"CHF\",\"base\":\"EUR\",\"count\":5,\"min\":\"0.943\",\"max\":\"0.9453\",\"mean\":\"0.944280\",\"points\":[{\"date\":\"2025-01-27\",\"rate\":\"0.9453\"},{\"date\":\"2025-01-28\",\"rate\":\"0.9441\"},{\"date\":\"2025-01-29\",\"rate\":\"0.943\"},{\"date\":\"2025-01-30\",\"rate\":\"0.9441\"},{\"date\":\"2025-01-31\",\"rate\":\"0.9449\"}]}\nEOF",
              "stories": [
                "api_history",
                "database"
              ]
            },
            {
              "name": "report-history-errors",
              "text": "http H19 404 '/history/HRK' < /dev/null",
              "stories": [
                "api_history",
                "cli_errors"
              ]
            },
            {
              "name": "retrieve-currency-history",
              "text": "http H20 200 '/history/USD?start=2025-02-01' <<'EOF'\n{\"currency\":\"USD\",\"base\":\"EUR\",\"count\":0,\"min\":null,\"max\":null,\"mean\":null,\"points\":[]}\nEOF",
