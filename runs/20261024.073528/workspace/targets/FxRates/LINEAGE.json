        {
          "commit": "435a905",
          "date": "2026-10-24",
          "hash": "f762e7650270073d828bdee60efe9c2cbaf4479a375598dc2b0ecbec9d762f3b",
          "release": "",
          "state": "consumed",
          "via": "plan",
          "ticket": null,
          "requirements": [
            {
              "name": "build-service-stack",
              "text": "Implement in Python 3.11 or newer with FastAPI, served by uvicorn, over SQLite.",
              "stories": [
                "foundation"
              ]
            },
            {
              "name": "rates-schema",
              "text": "| `rates` | `date` text `YYYY-MM-DD`, `currency` text, `rate` text | primary key (`date`, `currency`) |",
              "stories": [
                "data_schema"
              ]
            },
            {
              "name": "load-ecb-history",
              "text": "`fxrates load <csv>` | Loads an ECB history file (rules below). | `dates,rates`, then the number of dates and of rates stored from the file.",
              "stories": [
                "data_load"
              ]
            },
            {
              "name": "fetch-ecb-history",
              "text": "`fxrates fetch` | Downloads `https://www.ecb.europa.eu/stats/eurofxref/eurofxref-hist.zip`, extracts `eurofxref-hist.csv`, and loads it as `load`. | As `load`.",
              "stories": [
                "data_fetch"
              ]
            },
            {
              "name": "provide-cli-commands",
              "text": "The product is an executable named `fxrates` at the application root.",
              "stories": [
                "cli_interface"
              ]
            },
            {
              "name": "serve-health-stats-currencies",
              "text": "| `GET /health` | `{\"status\": \"ok\"}` |",
              "stories": [
                "api_overview"
              ]
            },
            {
              "name": "query-effective-and-latest-rates",
              "text": "**Effective date.** The ECB publishes on working days only. A request for date `D` uses the latest publication date on or before `D`. If none exists, the response is `404`.",
              "stories": [
                "api_rates"
              ]
            },
            {
              "name": "convert-currency",
              "text": "`GET /convert?from=<code>&to=<code>&amount=<amount>[&date=<date>]` | `{\"date\": <effective date>, \"from\": <code>, \"to\": <code>, \"amount\": <amount>, \"rate\": <rate>, \"result\": <result>}`. Without `date`, the latest publication date is used.",
              "stories": [
                "api_conversion"
              ]
            },
            {
              "name": "return-currency-history",
              "text": "`GET /history/{code}[?start=<date>][&end=<date>]` | `{\"currency\": <code>, \"base\": \"EUR\", \"count\": <n>, \"min\": <rate>, \"max\": <rate>, \"mean\": <mean>, \"points\": [{\"date\": <date>, \"rate\": <rate>}, ...]}` for the publication dates from `start` through `end` inclusive, ascending. Both bounds are optional. With no points, `count` is `0`, `min`, `max`, and `mean` are `null`, and `points` is `[]`.",
              "stories": [
                "api_history"
              ]
            },
            {
              "name": "provide-project-test-suite",
              "text": "The completed application provides a POSIX-compatible `bin/test.sh` that runs its own pytest suite from the application root and exits zero only when every test passes.",
              "stories": [
                "project_tests"
              ]
            }
          ]
        }
      ]
    },
